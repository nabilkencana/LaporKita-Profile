{
  "cleanUrls": true,
  "rewrites": [
    { "source": "/features", "destination": "/subpages/features.html" },
    { "source": "/pricing", "destination": "/subpages/pricing.html" },
    { "source": "/waitlist", "destination": "/subpages/waitlist.html" },
    { "source": "/contact", "destination": "/subpages/contact.html" },
    { "source": "/privacy", "destination": "/subpages/privacy.html" },
    { "source": "/terms", "destination": "/subpages/terms.html" },
    { "source": "/changelog", "destination": "/subpages/changelog.html" },
    { "source": "/home-2", "destination": "/subpages/home-2.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/scripts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*).html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
